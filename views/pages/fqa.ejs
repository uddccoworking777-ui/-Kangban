<%- include('../partials/head') %>
<% const qa = {
  '訂購與付款': [
    ['一定要加入會員才能購買嗎？', '不用，您可以直接結帳。加入會員後，可以隨時查詢訂單紀錄，下次購物也不用重新填寫資料。'],
    ['有哪些付款方式？', '目前提供信用卡、ATM 轉帳、超商取貨付款，詳情請見「<a href="/shopping-guide">購物須知</a>」。'],
    ['可以開公司統編發票嗎？', '可以。結帳時選擇「公司統編」，填寫統一編號與公司抬頭即可。'] ],
  '配送': [
    ['下單後多久會收到？', `付款完成後 ${settings.ship_days} 個工作天內出貨，宅配一般出貨後 ${settings.delivery_days} 天送達，實際時間依物流而定。`],
    ['運費怎麼計算？有免運嗎？', `單筆滿 ${money(freeShip)} 免運，未滿額宅配運費 ${money(ship.home.fee)}、超商取貨 ${money(ship.cvs.fee)}。`],
    ['可以寄到離島或海外嗎？', '離島地區請先聯繫客服確認運費。目前暫不提供海外配送。'] ],
  '退換貨': [
    ['尺寸不合可以換嗎？', '未拆封、未使用的商品，可於到貨後 7 天內申請更換尺寸一次，詳情請見「<a href="/return-policy">退換貨政策</a>」。'],
    ['收到的商品有瑕疵怎麼辦？', '請先拍照，並儘快透過 LINE 或客服信箱與我們聯繫，我們會全額負擔運費並為您更換。'] ],
  '商品與使用': [
    ['護具要怎麼選尺寸？', '每個護具商品頁都有尺寸對照表。請依表中標示的位置量測周長。如果剛好卡在兩個尺碼之間，歡迎詢問客服。'],
    ['怎麼確認商品是合法的醫療器材？', '醫療器材類商品的許可證字號標示於商品頁面。您可以到衛生福利部食品藥物管理署的醫療器材許可證查詢系統，輸入字號查詢。'],
    ['商品可以治療我的疼痛或疾病嗎？', '本商店無法提供醫療診斷或治療建議。如有身體不適，請先就醫，並依醫師或藥師建議選擇適合的用品。'] ],
}; %>
<section class="page-hero"><div class="container"><h1>常見問題</h1></div></section>
<div class="container page doc">
  <nav class="toc"><% Object.keys(qa).forEach((k, i) => { %><a href="#q<%= i %>"><%= k %></a><% }) %></nav>
  <% Object.entries(qa).forEach(([k, items], i) => { %>
    <section id="q<%= i %>">
      <h2><%= k %></h2>
      <% items.forEach(([q, a]) => { %><details class="faq"><summary>Q：<%= q %></summary><p>A：<%- a %></p></details><% }) %>
    </section>
  <% }) %>
  <p class="muted">找不到答案嗎？<a href="/contactus">聯絡我們</a></p>
</div>
<%- include('../partials/foot') %>
